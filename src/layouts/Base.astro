---
// Self-hosted fonts (no Google Fonts CDN request) — GDPR-friendly.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { data, DEFAULT_LANG } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical = 'https://tareqjami.de/' } = Astro.props;
const lang = DEFAULT_LANG;
const d = data[lang];

// Entity graph for search engines and answer engines: this site is the personal
// profile, jami-it.de is the freelance practice run under the same name. Stating
// the relation explicitly keeps the two domains from reading as unrelated.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://tareqjami.de/#person',
      name: 'Tareq Jami',
      url: 'https://tareqjami.de/',
      jobTitle: 'Software Engineer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Hamburg',
        addressCountry: 'DE',
      },
      worksFor: { '@id': 'https://jami-it.de/#organization' },
      sameAs: [
        'https://jami-it.de',
        'https://github.com/Mr-Jami',
        'https://linkedin.com/in/tareqjami',
        'https://medium.com/@tareqjami',
        'https://stackoverflow.com/users/14259165/t-jami',
      ],
    },
    {
      '@type': 'Organization',
      '@id': 'https://jami-it.de/#organization',
      name: 'Jami IT',
      url: 'https://jami-it.de',
      email: 'info@jami-it.de',
      founder: { '@id': 'https://tareqjami.de/#person' },
      description:
        'Freelance software engineering and AI consulting practice of Tareq Jami, based in Hamburg.',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://tareqjami.de/#website',
      url: 'https://tareqjami.de/',
      name: 'Tareq Jami',
      inLanguage: ['en', 'de'],
      about: { '@id': 'https://tareqjami.de/#person' },
      publisher: { '@id': 'https://jami-it.de/#organization' },
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%91%8B%3C/text%3E%3C/svg%3E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tareq Jami" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <!-- Apply saved theme + language before paint to avoid flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
          var l = localStorage.getItem('lang');
          if (l !== 'en' && l !== 'de') l = 'en';
          document.documentElement.setAttribute('lang', l);
          document.documentElement.setAttribute('data-lang', l);
          // Marks JS availability so CSS may hide elements for animated reveals.
          document.documentElement.classList.add('js');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="top">
      <a href="/" class="brand">Tareq Jami</a>
      <slot name="nav" />
      <div class="controls">
        <div class="seg" id="lang-seg" role="group" aria-label="Language / Sprache">
          <button class="seg-opt" type="button" data-lang-opt="en" aria-label="Switch to English">EN</button>
          <button class="seg-opt" type="button" data-lang-opt="de" aria-label="Auf Deutsch umschalten">DE</button>
        </div>
        <button
          class="theme-switch"
          id="theme-btn"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label={d.ui.themeToggleAria}>
          <span class="ts-track" aria-hidden="true">
            <span class="ts-knob">
              <!-- Tabler icons (MIT), inlined to avoid a dependency for two glyphs -->
              <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 12.1l.7 .7m-12.1 -.7l-.7 .7" /></svg>
              <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" /></svg>
            </span>
          </span>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <p>
        © <span id="year"></span> Tareq Jami ·
        <a href="https://jami-it.de" rel="noopener">Jami IT</a> ·
        <a href="/impressum"
          ><span data-lang-block="en">Imprint</span><span data-lang-block="de"
            >Impressum</span
          ></a
        > ·
        <a href="/datenschutz"
          ><span data-lang-block="en">Privacy</span><span data-lang-block="de"
            >Datenschutz</span
          ></a
        > · <a href="#top">↑</a>
      </p>
    </footer>
  </body>
</html>
