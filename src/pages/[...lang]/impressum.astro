---
import Base from '../../layouts/Base.astro';
import { data, localePath } from '../../lib/i18n';
import type { LangProps } from '../../lib/routes';
export { getStaticPaths } from '../../lib/routes';

// German is the legally authoritative version; English is a convenience
// translation. Both live in this file; the route renders one of them.
const { lang } = Astro.props as LangProps;
const d = data[lang];
const meta = {
  de: {
    title: 'Impressum — Tareq Jami',
    description: 'Impressum von Jami IT (Tareq Jami), Hamburg.',
  },
  en: {
    title: 'Legal Notice — Tareq Jami',
    description: 'Legal notice for Jami IT (Tareq Jami), Hamburg.',
  },
}[lang];
---

<Base lang={lang} path="/impressum/" title={meta.title} description={meta.description}>
  <nav slot="nav" class="nav">
    <a href={localePath(lang, '/')} class="nav-link">← {d.ui.home}</a>
  </nav>

  <main id="main">
    <article class="legal">
      {/* German (authoritative) */}
      {lang === 'de' && (
      <div>
        <h1>Impressum</h1>

        <h2>Angaben gemäß § 5 DDG</h2>
        <p class="addr">
          <a href="https://jami-it.de" rel="noopener">Jami IT</a><br />
          Inhaber: Tareq Jami<br />
          Tilsiterstraße 142<br />
          22047 Hamburg<br />
          Deutschland
        </p>

        <h2>Kontakt</h2>
        <p>E-Mail: <a href="mailto:info@jami-it.de">info@jami-it.de</a></p>

        <h2>Umsatzsteuer-Identifikationsnummer</h2>
        <p>
          Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />
          DE406600643
        </p>

        <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
        <p class="addr">
          Tareq Jami<br />
          Tilsiterstraße 142<br />
          22047 Hamburg
        </p>

        <h2>Verbraucherstreitbeilegung / Universalschlichtungsstelle</h2>
        <p>
          Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor
          einer Verbraucherschlichtungsstelle teilzunehmen.
        </p>
      </div>
      )}

      {/* English (convenience translation) */}
      {lang === 'en' && (
      <div>
        <h1>Legal Notice</h1>

        <h2>Information pursuant to § 5 DDG</h2>
        <p class="addr">
          <a href="https://jami-it.de" rel="noopener">Jami IT</a><br />
          Owner: Tareq Jami<br />
          Tilsiterstraße 142<br />
          22047 Hamburg<br />
          Germany
        </p>

        <h2>Contact</h2>
        <p>Email: <a href="mailto:info@jami-it.de">info@jami-it.de</a></p>

        <h2>VAT identification number</h2>
        <p>
          VAT identification number pursuant to § 27 a of the German VAT Act (UStG):<br />
          DE406600643
        </p>

        <h2>Responsible for content pursuant to § 18 (2) MStV</h2>
        <p class="addr">
          Tareq Jami<br />
          Tilsiterstraße 142<br />
          22047 Hamburg
        </p>

        <h2>Consumer dispute resolution</h2>
        <p>
          We are not willing or obliged to participate in dispute resolution
          proceedings before a consumer arbitration board.
        </p>

        <p class="note">
          This English translation is provided for convenience. The German version
          is legally binding.
        </p>
      </div>
      )}
    </article>
  </main>

  <script>
    import { initControls } from '../../lib/ui';
    initControls();
  </script>
</Base>
