---
import Base from '../../../layouts/Base.astro';
import { data, localePath } from '../../../lib/i18n';
import { appNode } from '../../../lib/schema';
import type { LangProps } from '../../../lib/routes';
export { getStaticPaths } from '../../../lib/routes';

// Landing page for "Simple Shot Timer": store buttons, screenshots, what the
// app does, who it is for, privacy, and the facts of the current release.
// Deliberately no user-agent redirect to Google Play: Googlebot Smartphone's
// UA contains "Android", so a page that navigates away before it renders gets
// indexed as the Play Store listing instead of as this page. The Play badge
// is the primary CTA instead.
const { lang } = Astro.props as LangProps;
const d = data[lang];

const PLAY_URL = 'https://play.google.com/store/apps/details?id=cc.jami.simpleshottimer';
const REPO_URL = 'https://github.com/Mr-Jami/simple-shot-timer';
const ICON = '/apps/simpleshottimer/icon.png';
const PATH = '/apps/simpleshottimer/';
// Current release — keep in step with the Play Store listing / CHANGELOG.md.
const VERSION = '1.6.0';
const RELEASED = '2026-07-05';

// Screenshots: the Play Store listing images (src/assets/simpleshottimer),
// built by `npm run images`. Captions are baked into the images in English,
// so the alt text carries them for screen readers and the German page.
const SHOTS = ['detect', 'settings', 'review'] as const;
const shotSrc = (name: string, ext: string) =>
  `/apps/simpleshottimer/${name}-520.${ext} 520w, /apps/simpleshottimer/${name}-1040.${ext} 1040w`;

const t = {
  en: {
    title: 'Simple Shot Timer — free shot timer app for Android',
    description:
      'Simple Shot Timer: free Android shot timer for dry-fire and live-fire practice. Par drills, splits, history and CSV export. No ads, no tracking, no account.',
    tagline: 'Practical shot timer: par drills, splits, history & CSV. No ads, no tracking.',
    badgeAria: 'Get Simple Shot Timer on Google Play',
    soon: 'Coming soon',
    shots: {
      detect: 'The timer listens for each shot and times it automatically',
      settings: 'Settings: drill mode, random start delay, par time and beep volume',
      review: 'Shot-by-shot review with splits, fastest and slowest, and your own notes',
    },
    features: {
      heading: 'What it does',
      items: [
        ['Three drill modes', 'Standard (open string), Par (par time × cycles with optional rest) and Stage (single window up to 200 s).'],
        ['Start delay', 'Instant, fixed, or random within a min/max range — with a live countdown so you know the timer is running.'],
        ['Shot detection', 'Live microphone stream with peak detection, echo filter and beep blanking. A mic test screen with level meter lets you dial in sensitivity before going hot; manual shot input is always available.'],
        ['History & review', 'Every string is saved automatically. Review splits, fastest, slowest and average; add a label, notes and penalties.'],
        ['CSV export', 'Export one string or the whole history through the system share sheet — to email, cloud storage or a spreadsheet.'],
        ['Made for the range', 'Screen flash on beep for noisy or ear-pro-heavy environments, optional haptics, keep-screen-awake, and a monochrome Material 3 theme with light, dark and high-contrast options.'],
      ],
    },
    audience: {
      heading: 'Who it is for',
      text: 'Practical shooters who want fast feedback and accurate splits — at the range, in the dojo, or in a basement dry-fire setup. Built for repeatable drill work, not for a sales funnel: free, lean, no upsells.',
    },
    privacy: {
      heading: 'Privacy',
      items: [
        '100% on-device: no account, no cloud, no analytics, no ads, no tracking.',
        'The microphone is used live, in memory, only during an active string. No audio is recorded or transmitted.',
        'Permissions: microphone (shot detection, requested on first start), vibration (optional haptics), wake lock (keeps the screen on during a string).',
      ],
    },
    facts: {
      heading: 'Details',
      version: 'Version',
      released: 'Released',
      platform: 'Platform',
      platformValue: 'Android · free',
      languages: 'Languages',
      languagesValue: 'English, German, French, Spanish, Russian',
      source: 'Source code',
      sourceValue: 'Open source on GitHub (Apache-2.0)',
    },
  },
  de: {
    title: 'Simple Shot Timer — kostenlose Shot-Timer-App für Android',
    description:
      'Simple Shot Timer: kostenloser Android-Shot-Timer für Trocken- und Schießtraining. Par-Übungen, Splits, Verlauf und CSV-Export. Keine Werbung, kein Tracking, kein Konto.',
    tagline: 'Praktischer Shot-Timer: Par-Übungen, Splits, Verlauf & CSV. Keine Werbung, kein Tracking.',
    badgeAria: 'Simple Shot Timer bei Google Play laden',
    soon: 'Demnächst',
    shots: {
      detect: 'Der Timer hört jeden Schuss mit und stoppt ihn automatisch',
      settings: 'Einstellungen: Übungsmodus, zufällige Startverzögerung, Par-Zeit und Piepton-Lautstärke',
      review: 'Auswertung Schuss für Schuss mit Splits, schnellstem und langsamstem Schuss und eigenen Notizen',
    },
    features: {
      heading: 'Was die App kann',
      items: [
        ['Drei Übungsmodi', 'Standard (offene Serie), Par (Par-Zeit × Durchgänge mit optionaler Pause) und Stage (ein Zeitfenster bis 200 s).'],
        ['Startverzögerung', 'Sofort, fest oder zufällig in einem Min/Max-Bereich – mit Live-Countdown, damit klar ist, dass der Timer läuft.'],
        ['Schusserkennung', 'Live-Mikrofonstream mit Spitzenerkennung, Echo-Filter und Ausblendung des Pieptons. Ein Mikrofon-Test mit Pegelanzeige hilft, die Empfindlichkeit vorab einzustellen; Schüsse lassen sich jederzeit manuell eintragen.'],
        ['Verlauf & Auswertung', 'Jede Serie wird automatisch gespeichert. Splits, schnellster, langsamster und durchschnittlicher Schuss; Bezeichnung, Notizen und Strafen pro Serie.'],
        ['CSV-Export', 'Eine Serie oder den ganzen Verlauf über das System-Teilen-Menü exportieren – per E-Mail, in die Cloud oder in eine Tabelle.'],
        ['Gemacht für den Stand', 'Bildschirmblitz beim Piepton für laute Umgebungen und Gehörschutz, optionale Vibration, Bildschirm bleibt an, monochromes Material-3-Design mit hellem, dunklem und kontrastreichem Modus.'],
      ],
    },
    audience: {
      heading: 'Für wen',
      text: 'Sportschützen, die schnelles Feedback und genaue Splits wollen – auf dem Stand, im Dojo oder beim Trockentraining im Keller. Gebaut für wiederholbare Übungen, nicht für einen Verkaufstrichter: kostenlos, schlank, ohne Upsells.',
    },
    privacy: {
      heading: 'Datenschutz',
      items: [
        '100 % auf dem Gerät: kein Konto, keine Cloud, keine Analyse, keine Werbung, kein Tracking.',
        'Das Mikrofon wird nur während einer laufenden Serie live im Speicher genutzt. Es wird nichts aufgezeichnet oder übertragen.',
        'Berechtigungen: Mikrofon (Schusserkennung, beim ersten Start abgefragt), Vibration (optional), Wake-Lock (Bildschirm bleibt während einer Serie an).',
      ],
    },
    facts: {
      heading: 'Details',
      version: 'Version',
      released: 'Veröffentlicht',
      platform: 'Plattform',
      platformValue: 'Android · kostenlos',
      languages: 'Sprachen',
      languagesValue: 'Englisch, Deutsch, Französisch, Spanisch, Russisch',
      source: 'Quellcode',
      sourceValue: 'Open Source auf GitHub (Apache-2.0)',
    },
  },
}[lang];

const releasedLabel = new Date(RELEASED).toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  lang={lang}
  path={PATH}
  title={t.title}
  description={t.description}
  extraSchema={[
    appNode({
      path: PATH,
      lang,
      description: t.description,
      playUrl: PLAY_URL,
      icon: ICON,
      version: VERSION,
      datePublished: RELEASED,
      screenshots: SHOTS.map((s) => `/apps/simpleshottimer/${s}-1040.webp`),
      repo: REPO_URL,
    }),
  ]}>
  <nav slot="nav" class="nav">
    <a href={localePath(lang, '/')} class="nav-link">← {d.ui.home}</a>
  </nav>

  <main id="main">
    <section class="app-landing">
      <div class="app-icon" aria-hidden="true">
        <img src={ICON} alt="" width="120" height="120" />
      </div>

      <h1 class="app-name">Simple Shot Timer</h1>

      <p class="app-tagline">{t.tagline}</p>

      <div class="store-buttons">
        {/* Official Google Play badge — used unmodified per the Google Play
            badge guidelines. */}
        <a
          class="store-badge"
          href={PLAY_URL}
          target="_blank"
          rel="noopener"
          aria-label={t.badgeAria}>
          <img
            src="/apps/simpleshottimer/gplay-en.png"
            alt="Get it on Google Play"
            width="180"
            height="70"
          />
        </a>

        {/* App Store: neutral "coming soon" chip, not Apple's official badge —
            the app is not listed on the App Store yet. */}
        <span class="store-soon" aria-disabled="true">
          <svg viewBox="0 0 384 512" width="20" height="20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
            ></path>
          </svg>
          <span class="store-soon-text">
            <strong>App Store</strong>
            <small>{t.soon}</small>
          </span>
        </span>
      </div>
    </section>

    <section class="app-section">
      <ul class="shots">
        {SHOTS.map((name) => (
          <li>
            <picture>
              <source type="image/avif" srcset={shotSrc(name, 'avif')} sizes="(max-width: 640px) 80vw, 300px" />
              <img
                src={`/apps/simpleshottimer/${name}-520.webp`}
                srcset={shotSrc(name, 'webp')}
                sizes="(max-width: 640px) 80vw, 300px"
                alt={t.shots[name]}
                width="520"
                height="867"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </li>
        ))}
      </ul>
    </section>

    <section class="app-section prose">
      <h2>{t.features.heading}</h2>
      <dl class="feature-list">
        {t.features.items.map(([name, desc]) => (
          <div class="feature">
            <dt>{name}</dt>
            <dd>{desc}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="app-section prose">
      <h2>{t.audience.heading}</h2>
      <p>{t.audience.text}</p>
    </section>

    <section class="app-section prose">
      <h2>{t.privacy.heading}</h2>
      <ul class="bullets">
        {t.privacy.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="app-section prose">
      <h2>{t.facts.heading}</h2>
      <dl class="facts">
        <div><dt>{t.facts.version}</dt><dd>{VERSION}</dd></div>
        <div><dt>{t.facts.released}</dt><dd><time datetime={RELEASED}>{releasedLabel}</time></dd></div>
        <div><dt>{t.facts.platform}</dt><dd>{t.facts.platformValue}</dd></div>
        <div><dt>{t.facts.languages}</dt><dd>{t.facts.languagesValue}</dd></div>
        <div><dt>{t.facts.source}</dt><dd><a href={REPO_URL} target="_blank" rel="noopener">{t.facts.sourceValue} <span class="ext">↗</span></a></dd></div>
      </dl>
      <p class="store-buttons store-buttons-bottom">
        <a class="store-badge" href={PLAY_URL} target="_blank" rel="noopener" aria-label={t.badgeAria}>
          <img src="/apps/simpleshottimer/gplay-en.png" alt="Get it on Google Play" width="180" height="70" loading="lazy" />
        </a>
      </p>
    </section>
  </main>

  <style>
    .app-landing {
      max-width: 520px;
      margin: clamp(2.5rem, 8vh, 5rem) auto 0;
      padding: 0 1.25rem;
      text-align: center;
    }
    .app-icon {
      width: 120px;
      height: 120px;
      margin: 0 auto 1.5rem;
      display: grid;
      place-items: center;
      border-radius: 26%;
      background: #000;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }
    .app-icon img {
      width: 76%;
      height: 76%;
      object-fit: contain;
    }
    .app-name {
      font-size: clamp(1.7rem, 5vw, 2.2rem);
      margin-bottom: 0.6rem;
    }
    .app-tagline {
      color: var(--muted);
      margin: 0 auto 2rem;
      max-width: 36ch;
    }
    .store-buttons {
      display: flex;
      gap: 0.85rem;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
    }
    /* Official badge: keep aspect ratio, do not recolor or distort. */
    .store-badge {
      display: inline-flex;
      transition: transform 0.1s ease;
    }
    .store-badge:hover {
      text-decoration: none;
      transform: translateY(-1px);
    }
    .store-badge img {
      height: 56px;
      width: auto;
      display: block;
    }
    /* Neutral placeholder until the App Store listing exists. */
    .store-soon {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.55rem 1rem;
      border-radius: 12px;
      background: var(--bg-card);
      color: var(--muted);
      border: 1px solid var(--border);
      cursor: not-allowed;
    }
    .store-soon-text {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
      text-align: left;
    }
    .store-soon-text strong {
      font-size: 1rem;
      font-weight: 600;
    }
    .store-soon-text small {
      font-size: 0.7rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    /* Content below the store buttons */
    .app-section {
      max-width: 720px;
      margin: 0 auto;
      padding: clamp(2rem, 5vw, 3.5rem) 1.25rem 0;
    }
    .app-section h2 {
      font-size: 1.35rem;
      margin-bottom: 0.9rem;
    }
    .app-section:last-child {
      padding-bottom: clamp(3rem, 8vw, 5rem);
    }
    .shots {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      gap: 1rem;
      justify-content: center;
    }
    .shots li {
      flex: 0 1 300px;
      min-width: 0;
    }
    .shots img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }
    @media (max-width: 640px) {
      .shots {
        justify-content: flex-start;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 0.5rem;
        margin: 0 -1.25rem;
        padding-inline: 1.25rem;
      }
      .shots li {
        flex: 0 0 80vw;
        scroll-snap-align: center;
      }
    }
    .feature-list {
      margin: 0;
      display: grid;
      gap: 1.1rem;
    }
    .feature dt {
      font-weight: 700;
    }
    .feature dd {
      margin: 0.15rem 0 0;
      color: var(--muted);
    }
    .facts {
      margin: 0 0 1.6rem;
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.4rem 1.4rem;
    }
    .facts div {
      display: contents;
    }
    .facts dt {
      color: var(--muted);
    }
    .facts dd {
      margin: 0;
    }
    .store-buttons-bottom {
      justify-content: flex-start;
      margin: 0;
    }
  </style>

  <script>
    import { initControls } from '../../../lib/ui';
    initControls();
  </script>
</Base>
