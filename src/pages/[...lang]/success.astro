---
import Base from '../../layouts/Base.astro';
import { data, localePath } from '../../lib/i18n';
import type { LangProps } from '../../lib/routes';
export { getStaticPaths } from '../../lib/routes';

// Fallback page Netlify redirects to after a no-JS form submission (the
// contact form's action points at the success page of its own language).
const { lang } = Astro.props as LangProps;
const d = data[lang];
const t = {
  en: {
    title: 'Thank you · Tareq Jami',
    description: 'Your message has been received.',
    heading: 'Thank you!',
    body: 'Your message has been sent. I’ll get back to you soon.',
    back: 'Back to home',
  },
  de: {
    title: 'Vielen Dank · Tareq Jami',
    description: 'Deine Nachricht ist angekommen.',
    heading: 'Vielen Dank!',
    body: 'Deine Nachricht wurde gesendet. Ich melde mich bald.',
    back: 'Zurück zur Startseite',
  },
}[lang];
---

<Base lang={lang} path="/success/" title={t.title} description={t.description} noindex>
  <nav slot="nav" class="nav">
    <a href={localePath(lang, '/')} class="nav-link">← {d.ui.home}</a>
  </nav>

  <main id="main">
    <article class="legal success">
      <h1>{t.heading}</h1>
      <p>{t.body}</p>
      <p class="success-back"><a class="btn btn-ghost" href={localePath(lang, '/')}>{t.back}</a></p>
    </article>
  </main>

  <style>
    .success {
      text-align: center;
    }
    .success-back {
      margin-top: 1.6rem;
    }
  </style>

  <script>
    import { initControls } from '../../lib/ui';
    initControls();
  </script>
</Base>
